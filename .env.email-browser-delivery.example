# Optional SERVER-ONLY tuning. Defaults are conservative; no queue-service keys needed.
# Clamped to 1..5 serial messages per request (default 1).
EMAIL_DELIVERY_BATCH_SIZE=1
# Soft work budget, clamped to 5000..20000 ms (default 15000).
# API maxDuration is 60 seconds, leaving room for result persistence/response.
EMAIL_DELIVERY_BATCH_BUDGET_MS=15000
# End a tuned multi-message batch early at this process RSS soft budget (MiB).
# A batch always attempts one message so elevated dev-server RSS cannot strand it.
EMAIL_DELIVERY_RSS_BUDGET_MB=512
# Temporary numeric diagnostics only; leave disabled for normal operation.
EMAIL_DELIVERY_MEMORY_DIAGNOSTICS=0
# Preserve existing MongoDB, auth, Gmail/Drive OAuth, OTP secret and PIN pepper.
